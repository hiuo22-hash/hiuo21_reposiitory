# Google Drive Service Account Credentials
# Option 1: Path to local JSON key file (for local development)
GOOGLE_CREDENTIALS_PATH=credentials.json
# Option 2: Base64-encoded JSON (for GitHub Actions secrets)
# GOOGLE_CREDENTIALS_JSON=<base64_encoded_service_account_json>

# Google Drive 통화 녹음 폴더 ID
# 경로: 10.동기화 / 5. 녹음 / Call
GOOGLE_DRIVE_FOLDER_ID=19x1kCDMq-A_MJpHxCTFtbIjIfTVKTsgI

# OpenAI API key for Whisper transcription
OPENAI_API_KEY=sk-...

# Anthropic API key for Claude summarization
ANTHROPIC_API_KEY=sk-ant-...

# Notion integration token
NOTION_TOKEN=secret_...

# Notion "업무 관리" 데이터베이스 ID
